{
  "name": "@cx/schemes",
  "version": "3.5.21",
  "description": "internal schemes packages",
  "main": "index.js",
  "module": "dist/schemes.esm-bundler.js",
  "types": "dist/schemes.d.ts",
  "files": [
    "index.js",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/schemes.d.ts",
      "node": {
        "production": "./dist/schemes.cjs.prod.js",
        "development": "./dist/schemes.cjs.js",
        "default": "./index.js"
      },
      "module": "./dist/schemes.esm-bundler.js",
      "import": "./dist/schemes.esm-bundler.js",
      "require": "./index.js"
    },
    "./*": "./*"
  },
  "sideEffects": false,
  "buildOptions": {
    "formats": [
      "esm-bundler",
      "cjs"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuejs/core.git",
    "directory": "packages/schemes"
  },
  "keywords": [
    "vue"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vuejs/core/issues"
  },
  "homepage": "https://github.com/vuejs/core/tree/main/packages/schemes#readme",
  "dependencies": {
    "@babel/core": "^7.28.6",
    "@babel/types": "^7.28.6",
    "@milkdown/crepe": "^7.18.0",
    "@milkdown/kit": "^7.18.0",
    "@milkdown/theme-nord": "^7.18.0",
    "@milkdown/vue": "^7.18.0",
    "@tiptap/core": "^3.14.0",
    "@tiptap/extension-document": "^3.14.0",
    "@tiptap/extension-paragraph": "^3.14.0",
    "@tiptap/extension-text": "^3.14.0",
    "@tiptap/extensions": "^3.14.0",
    "@tiptap/pm": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "@tiptap/vue-3": "^3.14.0",
    "recorder-core": "^1.3.25011100",
    "vite": "^7.1.2",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.2.9"
  }
}
