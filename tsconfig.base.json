{
  "compilerOptions": {
    /** 基本选项 */

    // 是否生成对应的 .map 文件
    "sourceMap": false,
    // 指定ECMAScript目标版本
    "target": "es2016",
    // 指定输出代码的换行符格式
    "newLine": "LF",
    // 类字段编译后是否使用原始定义属性的方式
    "useDefineForClassFields": false,
    // 指定生成哪个模块系统代码
    "module": "esnext",
    // 允许编译器编译JavaScript文件
    "allowJs": false,
    // 启用实验性的ES装饰器支持
    "experimentalDecorators": true,
    // 启用将每个文件作为单独的模块进行编译
    "isolatedModules": false,
    // 跳过所有声明文件的类型检查
    "skipLibCheck": true,
    // 是否移除注释
    "removeComments": false,
    // 指定JSX代码的生成方式
    "jsx": "preserve",
    // 指定代码运行时需要包含的库文件
    "lib": ["ESNext", "dom"],
    // 指定输入文件的根目录
    "rootDir": ".",
    // 导出内容是否需要充分的类型注释
    "isolatedDeclarations": false,
    // 启用项目编译
    "composite": true,
    // 导入文件时确保与文件名大小写一致
    "forceConsistentCasingInFileNames": true,

    /** 类型检查选项 */

    // 启用所有严格类型检查选项
    "strict": true,
    // 启用对null的检查
    "strictNullChecks": true,
    // 启用对函数类型的检查
    "strictFunctionTypes": false,
    // 启用对属性初始化的检查
    "strictPropertyInitialization": false,
    // 启用对隐式any的检查
    "noImplicitAny": true,
    // 启用对this参数的隐式any的检查
    "noImplicitThis": true,
    // 启用对函数返回值的隐式any的检查
    "noImplicitReturns": false,
    // 启用对函数有未使用的参数的检查
    "noUnusedParameters": false,
    // 在单独的作用域中检查未使用的局部变量
    "noUnusedLocals": false,

    /** 模块解析选项 */

    // 指定模块解析策略
    "moduleResolution": "node",
    // 指定基础目录
    "baseUrl": ".",
    // 允许没有默认导出的模块默认导入
    "allowSyntheticDefaultImports": true,
    // 允许通过默认导入导入CommonJS模块
    "esModuleInterop": true,
    // 允许解析JSON
    "resolveJsonModule": true,
    // 指定要包含的类型声明文件
    "types": ["node"],
    // 指定模块名到基于 baseUrl 的路径映射
    "paths": {
      "@cx": ["packages/cx"],
      "@cx/components": ["./packages/components"],
      "@cx/components/*": ["./packages/components/*"],
      "@cx/utils": ["./packages/utils"],
      "@cx/utils/*": ["./packages/utils/*"],
      "@cx/hooks": ["./packages/hooks"],
      "@cx/hooks/*": ["./packages/hooks/*"],
      "@cx/schemes/*": ["./packages/schemes/*"]
    }
  },
  // 指定要包含在编译中的文件
  "include": [
    "internal/**/*",
    "packages/**/*",
    "examples/**/*",
    "scripts/*",
    "schemes/**/*",
    "*.d.ts"
  ],
  // 指定要从编译中排除的文件
  "exclude": ["node_modules"]
}
